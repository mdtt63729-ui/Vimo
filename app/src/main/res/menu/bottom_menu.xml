  offer the same tabs in the same order.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/homeFragment"
        android:icon="@drawable/ic_home"
        android:title="@string/startpage" />

    <item
        android:id="@+id/shortsFragment"
        android:icon="@drawable/ic_shorts_outline"
        android:title="@string/shorts" />

    <item
        android:id="@+id/downloadsFragment"
        android:icon="@drawable/ic_download_filled"
        android:title="@string/downloads" />

    <item
        android:id="@+id/libraryFragment"
        android:icon="@drawable/ic_library"
        android:title="@string/library" />

</menu>

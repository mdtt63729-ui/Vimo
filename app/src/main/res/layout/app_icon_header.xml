<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:gravity="center">

    <!-- Circular developer photo with animated wave border -->
    <FrameLayout
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:layout_marginTop="36dp">

        <!-- Animated wave/coral border (Material 3) -->
        <com.atube.app.ui.views.WaveCircleBorder
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Circular photo — high quality, no downscale -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/dev_photo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/dev_photo"
            app:shapeAppearanceOverlay="@style/CircleShape"
            tools:ignore="ContentDescription" />

    </FrameLayout>

    <!-- Developer name -->
    <TextView
        android:id="@+id/dev_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="manik@developer"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:alpha="0.7" />

    <!-- App name (no debug/release label) -->
    <TextView
        android:id="@+id/app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/app_name"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Version number -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/version_card"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="36dp">

        <TextView
            android:id="@+id/version_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginVertical="4dp"
            android:textSize="13sp"
            tools:text="v32.1 (72)" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

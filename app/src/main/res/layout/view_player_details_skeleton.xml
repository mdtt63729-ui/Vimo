<?xml version="1.0" encoding="utf-8"?>
<!--
  Skeleton for the video details column: the same shimmering grey blocks the
  home feed uses, arranged the way the real details are laid out (title, action
  buttons, channel row, related videos). It is swapped for the real content as
  soon as the stream info arrives - see PlayerFragment.toggleVideoInfoVisibility.

  The shimmer itself is attached at runtime by PlayerDetailsSkeletonView, which
  also rounds every block, so nothing here needs a background.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="96dp" />

    <View
        android:layout_width="150dp"
        android:layout_height="12dp"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <View
            android:layout_width="78dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp" />

        <View
            android:layout_width="78dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp" />

        <View
            android:layout_width="78dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp" />

        <View
            android:layout_width="78dp"
            android:layout_height="32dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="132dp"
                android:layout_height="14dp" />

            <View
                android:layout_width="92dp"
                android:layout_height="11dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <View
            android:layout_width="82dp"
            android:layout_height="32dp" />

    </LinearLayout>

    <View
        android:layout_width="112dp"
        android:layout_height="14dp"
        android:layout_marginTop="26dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <View
            android:layout_width="150dp"
            android:layout_height="84dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="40dp" />

            <View
                android:layout_width="104dp"
                android:layout_height="11dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <View
            android:layout_width="150dp"
            android:layout_height="84dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="40dp" />

            <View
                android:layout_width="104dp"
                android:layout_height="11dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <View
            android:layout_width="150dp"
            android:layout_height="84dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="40dp" />

            <View
                android:layout_width="104dp"
                android:layout_height="11dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

</merge>

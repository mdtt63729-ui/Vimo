<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/downloadScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dl_page_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="40dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMART DOWNLOADER"
            android:textColor="@color/dl_blue"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Paste &amp; Download"
            android:textColor="@color/dl_ink"
            android:textSize="27sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="One link. Your preferred quality."
            android:textColor="@color/dl_muted"
            android:textSize="14sp" />

        <!-- URL composer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_dl_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:gravity="center"
                    android:text="↗"
                    android:textColor="@color/dl_blue"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="Media URL"
                    android:textColor="@color/dl_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dl_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <EditText
                    android:id="@+id/linkInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/fetch_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textColor="@color/dl_ink"
                    android:textColorHint="@color/dl_hint"
                    android:textSize="14sp"
                    android:importantForAutofill="no" />

                <ImageView
                    android:id="@+id/pasteButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/dl_paste"
                    android:padding="10dp"
                    android:src="@drawable/ic_content_paste_24"
                    android:tint="@color/dl_blue"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Paste a link from any supported site"
                android:textColor="@color/dl_muted"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/fetchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_dl_primary_capsule"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:minWidth="168dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="Analyse link"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Reuses the same shimmer drawable as the Home feed. -->
        <LinearLayout
            android:id="@+id/fetchSkeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dl_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <View
                android:id="@+id/skeletonThumb"
                android:layout_width="match_parent"
                android:layout_height="170dp" />
            <View
                android:id="@+id/skeletonLine1"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="16dp" />
            <View
                android:id="@+id/skeletonLine2"
                android:layout_width="200dp"
                android:layout_height="12dp"
                android:layout_marginTop="8dp" />
            <View
                android:id="@+id/skeletonLine3"
                android:layout_width="140dp"
                android:layout_height="12dp"
                android:layout_marginTop="8dp" />
            <View
                android:id="@+id/skeletonRow1"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="16dp" />
            <View
                android:id="@+id/skeletonRow2"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp" />
            <View
                android:id="@+id/skeletonRow3"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp" />
            <View
                android:id="@+id/skeletonRow4"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/fetchEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_dl_card"
            android:gravity="center"
            android:padding="22dp"
            android:text="@string/fetch_empty_message"
            android:textColor="@color/dl_muted"
            android:textSize="13sp" />

        <!-- Result preview -->
        <LinearLayout
            android:id="@+id/previewSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dl_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/previewThumbnail"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/bg_thumbnail"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:clipToOutline="true" />

            <TextView
                android:id="@+id/previewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/dl_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/previewDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/dl_muted"
                android:textSize="13sp" />

            <!-- Moving indicator creates a shared fluid capsule between Video/Audio. -->
            <FrameLayout
                android:id="@+id/modeContainer"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_dl_mode_track"
                android:padding="4dp">

                <View
                    android:id="@+id/modeIndicator"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dl_primary_capsule" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/videoMode"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/dl_mode_video"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/audioMode"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/dl_mode_audio"
                        android:textColor="@color/dl_muted"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Quality"
                android:textColor="@color/dl_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/qualityContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/downloadButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_dl_primary_capsule"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:elevation="3dp"
                android:minHeight="56dp"
                android:text="@string/dl_download"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@color/dl_line" />

        <LinearLayout
            android:id="@+id/downloadsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Your downloads"
                    android:textColor="@color/dl_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/downloadsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/fetchEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/dl_muted"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="status" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

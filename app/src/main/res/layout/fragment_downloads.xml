<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dl_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/dl_subtitle"
            android:textColor="@color/dl_muted"
            android:textSize="14sp" />

        <!-- link field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_capsule"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↗"
                android:textColor="@color/dl_muted"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/linkInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/fetch_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="@color/dl_muted"
                android:textSize="14sp"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/pasteButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dl_paste"
                android:gravity="center"
                android:text="▣"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/fetchButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_capsule_selected"
            android:gravity="center"
            android:text="@string/dl_fetch"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- loading -->
        <LinearLayout
            android:id="@+id/fetchSkeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:id="@+id/skeletonThumb"
                android:layout_width="match_parent"
                android:layout_height="120dp" />

            <View
                android:id="@+id/skeletonLine1"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="12dp" />

            <View
                android:id="@+id/skeletonLine2"
                android:layout_width="200dp"
                android:layout_height="12dp"
                android:layout_marginTop="8dp" />

            <View
                android:id="@+id/skeletonLine3"
                android:layout_width="140dp"
                android:layout_height="12dp"
                android:layout_marginTop="8dp" />

            <View
                android:id="@+id/skeletonRow1"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp" />

            <View
                android:id="@+id/skeletonRow2"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp" />

            <View
                android:id="@+id/skeletonRow3"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp" />

            <View
                android:id="@+id/skeletonRow4"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- empty / error state -->
        <TextView
            android:id="@+id/fetchEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_capsule"
            android:gravity="center"
            android:padding="28dp"
            android:text="@string/fetch_empty_message"
            android:textColor="@color/dl_muted"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fetchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp"
            android:background="@color/dl_line" />

        <!-- downloads -->
        <LinearLayout
            android:id="@+id/downloadsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fetch_downloads"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/downloadsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/fetchEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/dl_muted"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="status" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

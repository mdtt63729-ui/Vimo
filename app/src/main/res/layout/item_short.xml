<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:descendantFocusability="blocksDescendants">

    <!-- Video Player Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/shortPlayerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:resize_mode="zoom"
        app:surface_type="texture_view"
        app:use_controller="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Gradient overlay for readability -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/shorts_gradient_overlay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Center Play/Pause button overlay -->
    <ImageButton
        android:id="@+id/shortPlayPauseBtn"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_pause"
        android:tint="@android:color/white"
        app:tint="@android:color/white"
        android:alpha="0.85"
        android:contentDescription="@string/play"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout
        android:id="@+id/shortActionsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Channel Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/shortChannelAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <!-- Like Button -->
        <ImageButton
            android:id="@+id/shortLikeBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_like"
            android:tint="@android:color/white"
            app:tint="@android:color/white"
            android:contentDescription="@string/like" />

        <TextView
            android:id="@+id/shortLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Comment Button -->
        <ImageButton
            android:id="@+id/shortCommentBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_comment"
            android:tint="@android:color/white"
            app:tint="@android:color/white"
            android:contentDescription="@string/comments" />

        <TextView
            android:id="@+id/shortCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Share Button -->
        <ImageButton
            android:id="@+id/shortShareBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share"
            android:tint="@android:color/white"
            app:tint="@android:color/white"
            android:contentDescription="@string/share" />

        <!-- Download Button -->
        <ImageButton
            android:id="@+id/shortDownloadBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_download"
            android:tint="@android:color/white"
            app:tint="@android:color/white"
            android:contentDescription="@string/download" />

        <!-- Mute/Unmute Button -->
        <ImageButton
            android:id="@+id/shortMuteBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_volume"
            android:tint="@android:color/white"
            app:tint="@android:color/white"
            android:contentDescription="@string/mute" />

    </LinearLayout>

    <!-- Bottom info: title, channel name, subscribe button (fixed, no shifting) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="80dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/shortActionsContainer">

        <TextView
            android:id="@+id/shortTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/shortChannelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shortSubscribeBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subscribe"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/shortDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Progress bar for buffering -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/shortBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:indicatorSize="36dp"
        app:trackThickness="3dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>

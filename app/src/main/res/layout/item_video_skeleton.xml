<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <!-- Thumbnail placeholder (16:9). The shimmer is attached at bind time. -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/skeleton_thumbnail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/skeleton_bg"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

    <!-- Avatar placeholder -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/skeleton_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:background="@color/skeleton_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skeleton_thumbnail"
        app:shapeAppearanceOverlay="@style/CircleImageView" />

    <!-- Title placeholder, line one -->
    <View
        android:id="@+id/skeleton_title_1"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="48dp"
        android:background="@color/skeleton_bg"
        app:layout_constraintBottom_toTopOf="@id/skeleton_title_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/skeleton_avatar"
        app:layout_constraintTop_toTopOf="@id/skeleton_avatar" />

    <!-- Title placeholder, line two -->
    <View
        android:id="@+id/skeleton_title_2"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="96dp"
        android:background="@color/skeleton_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/skeleton_avatar"
        app:layout_constraintTop_toBottomOf="@id/skeleton_title_1" />

    <!-- Channel and views placeholder -->
    <View
        android:id="@+id/skeleton_channel"
        android:layout_width="110dp"
        android:layout_height="12dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@color/skeleton_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/skeleton_avatar"
        app:layout_constraintTop_toBottomOf="@id/skeleton_title_2" />

</androidx.constraintlayout.widget.ConstraintLayout>

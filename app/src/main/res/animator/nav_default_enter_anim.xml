<?xml version="1.0" encoding="utf-8"?>
<!--
  One half of a true crossfade. The old screen fades out over exactly the time the
  new one fades in - no start offset - so there is never a frame with both screens
  blank. The previous version delayed the fade-in by 50 ms, which is the flash of
  background that showed between pages.
-->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="200"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:propertyName="alpha"
    android:valueFrom="0.0"
    android:valueTo="1.0"
    android:valueType="floatType" />

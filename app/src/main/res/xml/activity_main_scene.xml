<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <!--
      Only the container moves. The navigation bars deliberately have no
      keyframes: the old scene dropped the bar 80dp at frame 1 and brought it
      back by frame 100, which read as a jump as soon as the transition took a
      visible amount of time. The bar now stays exactly where it is, the way it
      does in YouTube, and the mini player rises to rest on top of it.

      The frame-100 translation of @id/container is replaced at runtime with the
      real distance from the bar's top edge to the bottom of the window - see
      MainActivity.updateBottomBarKeyFrames.
    -->
    <Transition
        android:id="@+id/bottom_bar_transition"
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@id/start"
        motion:duration="300"
        motion:motionInterpolator="decelerate"
        motion:layoutDuringTransition="honorRequest">
        <KeyFrameSet>
            <KeyAttribute
                android:translationY="0dp"
                motion:framePosition="0"
                motion:motionTarget="@+id/container" />

            <KeyAttribute
                android:translationY="-80dp"
                motion:framePosition="100"
                motion:motionTarget="@+id/container" />
        </KeyFrameSet>
    </Transition>

    <ConstraintSet android:id="@+id/start" />

    <ConstraintSet android:id="@+id/end" />
</MotionScene>
